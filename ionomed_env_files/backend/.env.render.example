# IonoMed - Variables para Render
# NO crear este archivo en producción.
# Estas variables se pegan en Render > Web Service > Environment.
# No configures PORT manualmente en Render; Render lo inyecta automáticamente.

NODE_ENV=production

# Reemplaza usuario, contraseña y cluster por los datos reales de MongoDB Atlas.
MONGODB_URI=mongodb+srv://IONOMED_USER:IONOMED_PASSWORD@cluster0.xxxxx.mongodb.net/ionomed?retryWrites=true&w=majority

# Debe ser una clave larga, privada y única.
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_MUY_LARGA_Y_SEGURA_DE_PRODUCCION
JWT_EXPIRES_IN=7d

# Reemplaza por el dominio real del frontend en Vercel.
FRONTEND_URL=https://ionomed.vercel.app
CORS_ORIGIN=https://ionomed.vercel.app

BCRYPT_SALT_ROUNDS=12
