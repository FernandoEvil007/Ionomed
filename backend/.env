# IonoMed - Backend local
# Ubicación: backend/.env
# Este archivo NO se sube a GitHub.

NODE_ENV=development
PORT=4000

# MongoDB local para desarrollo.
# Si no tienes MongoDB local, usa MongoDB Atlas y reemplaza esta línea por tu URI de Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/ionomed

# Cambiar en producción por una clave larga, privada y diferente.
JWT_SECRET=ionomed_dev_secret_cambiar_en_produccion_2026
JWT_EXPIRES_IN=7d

# URL del frontend local para CORS.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Seguridad básica
BCRYPT_SALT_ROUNDS=10